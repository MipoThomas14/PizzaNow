<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="edu.ksu.pizzanow.ui.controller.HomeController"
  style="-fx-background-color: linear-gradient(to bottom right, #E75D48, #B92B27);"
  prefHeight="600.0" prefWidth="800.0">

  <!-- Main White Card -->
  <VBox alignment="CENTER" maxWidth="600.0" spacing="20.0"
    style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-background-radius: 30;">

    <padding>
      <Insets top="45" right="35" bottom="45" left="35" />
    </padding>

    <!-- Drop Shadow Effect for the Card -->
    <effect>
      <DropShadow color="#00000033" radius="40" offsetY="20" />
    </effect>

    <!-- Logo Section -->
    <HBox alignment="CENTER" spacing="10.0">

      <!-- logo -->
       <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
          <image>
            <Image url= "/logo.png" />
          </image>
       </ImageView>

      <Label text="PizzaNow" textFill="#C0392B">
        <font>
          <Font name="Segoe UI Bold" size="28.0" />
        </font>
      </Label>
      <VBox.margin>
        <Insets bottom="10.0" />
      </VBox.margin>
    </HBox>

    <!-- Headline -->
    <Label text="Hot &amp; Fresh Pizza&#10;Delivered to Your Door"
      textAlignment="CENTER" textFill="#2c2c2c" wrapText="true">
      <font>
        <Font name="Segoe UI Bold" size="24.0" />
      </font>
      <VBox.margin>
        <Insets bottom="20.0" />
      </VBox.margin>
    </Label>

    <!-- Form Area -->
    <VBox alignment="CENTER" spacing="15.0" prefWidth="100.0">

      <!-- Phone Input -->
      <TextField fx:id="phoneInput" promptText="Enter phone number" alignment="CENTER"
        style="-fx-background-color: #FAFAFA; -fx-border-color: #eeeeee; -fx-border-width: 2; -fx-border-radius: 15; -fx-background-radius: 15; -fx-padding: 15; -fx-font-size: 16px; -fx-prompt-text-fill: #aaaaaa;">
        <font>
          <Font name="Segoe UI" size="16.0" />
        </font>
      </TextField>

      <Label fx:id="phoneInputFeedback"
        text=""
        alignment="CENTER"
        style="
           -fx-background-color: transparent;
           -fx-text-fill: #E75D48;
           -fx-font-size: 13px;
       ">
        <font>
          <Font name="Segoe UI" size="13.0" />
        </font>
      </Label>

      <!-- Button: Continue -->
      <Button fx:id="btnContinue" text="Continue" maxWidth="Infinity"
        onAction="#onContinueClicked"
        style="-fx-background-color: #E75D48; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(231, 93, 72, 0.3), 10, 0, 0, 4);">
        <padding>
          <Insets top="15" bottom="15" />
        </padding>
      </Button>

      <!-- Button: New Customer -->
      <Button fx:id="btnNewCustomer" text="Continue as new customer" maxWidth="Infinity"
        onAction="#onNewCustomerClicked"
        style="-fx-background-color: transparent; -fx-text-fill: #E75D48; -fx-border-color: #E75D48; -fx-border-width: 2; -fx-border-radius: 15; -fx-background-radius: 15; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand;">
        <padding>
          <Insets top="14" bottom="14" />
        </padding>
      </Button>
    </VBox>

    <!-- Footer Text -->
    <Label text="Easy Ordering! Fast Delivery! Delicious Pizza!" textFill="#999999">
      <font>
        <Font name="Segoe UI Semibold" size="12.0" />
      </font>
      <VBox.margin>
        <Insets top="20.0" />
      </VBox.margin>
    </Label>

  </VBox>
</StackPane>