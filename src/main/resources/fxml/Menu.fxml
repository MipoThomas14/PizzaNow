<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="700.0" prefWidth="1100.0" 
           style="-fx-background-color: linear-gradient(to bottom right, #E75D48, #B92B27);" 
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="edu.ksu.pizzanow.ui.controller.MenuController">

    <!-- ScrollPane to handle screen sizes where horizontal width might be tight -->
    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background: transparent; -fx-background-color: transparent;">
        <content>
            <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: transparent;">
                <padding>
                    <Insets bottom="40.0" left="20.0" right="20.0" top="40.0" />
                </padding>

                <!-- Welcome Label -->
                <Label fx:id="lblWelcome" text="Welcome, Guest" textFill="WHITE">
                    <font>
                        <Font name="Segoe UI Bold" size="28.0" />
                    </font>
                    <effect>
                        <DropShadow color="#00000033" radius="2" offsetY="1"/>
                    </effect>
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Label>

                <!-- Main White Glass Card (Wide Layout) -->
                <VBox maxWidth="1050.0" maxHeight="650" spacing="25.0" 
                      style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 30;">
                    
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                    
                    <effect>
                        <DropShadow color="#00000033" offsetY="10" radius="30" />
                    </effect>

                    <!-- Main Header (Spans full width) -->
                    <HBox alignment="CENTER" spacing="10.0">
                        <SVGPath content="M12 2 L2.5 19.5 Q12 23 21.5 19.5 Z" fill="#C0392B" rotate="-15" scaleX="1.2" scaleY="1.2" />
                        <Label text="Our Menu" textFill="#C0392B">
                            <font>
                                <Font name="Segoe UI Bold" size="32.0" />
                            </font>
                        </Label>
                    </HBox>

                    <!-- Horizontal Container for Columns -->
                    <HBox spacing="25.0" alignment="TOP_CENTER">
                        
                        <!-- ================= COL 1: PREMADE PIZZAS ================= -->
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" minWidth="250.0">
                            <Label text="Premade Pizzas" textFill="#2c2c2c" maxWidth="Infinity" alignment="CENTER">
                                <font>
                                    <Font name="Segoe UI Bold" size="20.0" />
                                </font>
                            </Label>

                            <VBox spacing="15.0" alignment="TOP_CENTER">
                                <!-- Cheese Pizza Button -->
                                <Button fx:id="btnCheese" maxWidth="Infinity" text="Cheese Pizza" 
                                        onAction="#onCheeseClicked"
                                        style="-fx-background-color: #FFF5F4; -fx-text-fill: #E75D48; -fx-border-color: #E75D48; -fx-border-radius: 15; -fx-background-radius: 15; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;">
                                    <padding><Insets bottom="20" top="20" /></padding>
                                </Button>
                                
                                <!-- Pepperoni Pizza Button -->
                                <Button fx:id="btnPepperoni" maxWidth="Infinity" text="Pepperoni Pizza" 
                                        onAction="#onPepperoniClicked"
                                        style="-fx-background-color: #FFF5F4; -fx-text-fill: #E75D48; -fx-border-color: #E75D48; -fx-border-radius: 15; -fx-background-radius: 15; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;">
                                    <padding><Insets bottom="20" top="20" /></padding>
                                </Button>
                            </VBox>
                        </VBox>

                        <!-- Vertical Divider -->
                        <Region prefWidth="2.0" style="-fx-background-color: #E75D48; -fx-opacity: 0.2;" />

                        <!-- ================= COL 2: BUILD YOUR OWN (Wider) ================= -->
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" minWidth="400.0">
                            <Label text="Build Your Own Pizza" textFill="#2c2c2c" maxWidth="Infinity" alignment="CENTER">
                                <font>
                                    <Font name="Segoe UI Bold" size="20.0" />
                                </font>
                            </Label>

                            <!-- Row 1: Crust & Size -->
                            <HBox spacing="15.0">
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Crust Type" textFill="#777777" >
                                        <font><Font name="Segoe UI" size="12.0" /></font>
                                    </Label>
                                    <ComboBox fx:id="comboCrust" maxWidth="Infinity" promptText="Select Crust"
                                              style="-fx-background-color: #FAFAFA; -fx-border-color: #eeeeee; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 14px;">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="Thin" />
                                                <String fx:value="Regular" />
                                                <String fx:value="Cheesy" />
                                            </FXCollections>
                                        </items>
                                    </ComboBox>
                                </VBox>

                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Size" textFill="#777777">
                                        <font><Font name="Segoe UI" size="12.0" /></font>
                                    </Label>
                                    <ComboBox fx:id="comboSize" maxWidth="Infinity" promptText="Select Size"
                                              style="-fx-background-color: #FAFAFA; -fx-border-color: #eeeeee; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 14px;">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="Small" />
                                                <String fx:value="Medium" />
                                                <String fx:value="Large" />
                                                <String fx:value="Extra Large" />
                                            </FXCollections>
                                        </items>
                                    </ComboBox>
                                </VBox>
                            </HBox>

                            <!-- Row 2: Toppings -->
                            <HBox spacing="15.0">
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Topping 1 ($1.50)" textFill="#777777">
                                        <font><Font name="Segoe UI" size="12.0" /></font>
                                    </Label>
                                    <ComboBox fx:id="comboTopping1" maxWidth="Infinity" promptText="None"
                                              style="-fx-background-color: #FAFAFA; -fx-border-color: #eeeeee; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 14px;">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="Pepperoni" />
                                                <String fx:value="Sausage" />
                                                <String fx:value="Mushrooms" />
                                                <String fx:value="Extra Cheese" />
                                                <String fx:value="Bacon" />
                                                <String fx:value="Green Peppers" />
                                                <String fx:value="Pineapple" />
                                                <String fx:value="Spinach" />
                                            </FXCollections>
                                        </items>
                                    </ComboBox>
                                </VBox>

                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Topping 2 ($1.50)" textFill="#777777">
                                        <font><Font name="Segoe UI" size="12.0" /></font>
                                    </Label>
                                    <ComboBox fx:id="comboTopping2" maxWidth="Infinity" promptText="None"
                                              style="-fx-background-color: #FAFAFA; -fx-border-color: #eeeeee; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 14px;">
                                        <items>
                                            <FXCollections fx:factory="observableArrayList">
                                                <String fx:value="Pepperoni" />
                                                <String fx:value="Sausage" />
                                                <String fx:value="Mushrooms" />
                                                <String fx:value="Extra Cheese" />
                                                <String fx:value="Bacon" />
                                                <String fx:value="Green Peppers" />
                                                <String fx:value="Pineapple" />
                                                <String fx:value="Spinach" />
                                            </FXCollections>
                                        </items>
                                    </ComboBox>
                                </VBox>
                            </HBox>

                            <!-- Add Custom Order Button -->
                            <Button fx:id="btnAddCustom" maxWidth="Infinity" text="Add to Order"
                                    onAction="#onAddCustomClicked"
                                    style="-fx-background-color: #E75D48; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(231, 93, 72, 0.3), 10, 0, 0, 4);">
                                <padding><Insets bottom="12" top="12" /></padding>
                                <VBox.margin>
                                    <Insets top="10.0" />
                                </VBox.margin>
                            </Button>
                        </VBox>

                        <!-- Vertical Divider -->
                        <Region prefWidth="2.0" style="-fx-background-color: #E75D48; -fx-opacity: 0.2;" />

                        <!-- ================= COL 3: BEVERAGES ================= -->
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" minWidth="200.0" alignment="TOP_CENTER">
                            <Label text="Beverages" textFill="#2c2c2c" maxWidth="Infinity" alignment="CENTER">
                                <font>
                                    <Font name="Segoe UI Bold" size="20.0" />
                                </font>
                            </Label>

                            <!-- Soda Button with Toon SVG Icon -->
                            <Button fx:id="btnSoda" maxWidth="Infinity" text="2L Soda ($2)" contentDisplay="TOP"
                                    onAction="#onSodaClicked"
                                    style="-fx-background-color: #ffffff; -fx-text-fill: #444; -fx-border-color: #eeeeee; -fx-border-width: 2; -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;">
                                <graphic>
                                    <SVGPath content="M10,25 C10,27 12,28 15,28 C18,28 20,27 20,25 L22,8 L8,8 L10,25 Z M9,8 L21,8 L22,5 L8,5 L9,8 Z M18,5 L20,0 L18,0 L16,5 Z" 
                                             fill="#E75D48" scaleX="1.5" scaleY="1.5">
                                        <effect>
                                            <DropShadow color="#00000022" radius="2" offsetY="2"/>
                                        </effect>
                                    </SVGPath>
                                </graphic>
                                <padding>
                                    <Insets bottom="15" left="20" right="20" top="15" />
                                </padding>
                            </Button>
                        </VBox>

                    </HBox> <!-- End of Column Container -->
                    
                    <!-- ================= BOTTOM: CHECKOUT ================= -->
                    <Region prefHeight="10.0" /> <!-- Spacer -->
                    
                    <Button fx:id="btnContinueToCart" maxWidth="Infinity" text="Continue to Cart"
                            onAction="#onCheckoutClicked"
                            style="-fx-background-color: #B92B27; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 4);">
                        <padding>
                            <Insets bottom="15" top="15" />
                        </padding>
                    </Button>

                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</StackPane>