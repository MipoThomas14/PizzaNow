<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="700.0" prefWidth="1100.0" 
           style="-fx-background-color: linear-gradient(to bottom right, #E75D48, #B92B27);" 
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="edu.ksu.pizzanow.ui.controller.CartController">

    <VBox maxWidth="1000.0" maxHeight="650.0" spacing="0.0" 
          style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-background-radius: 30;">
        
        <effect>
            <DropShadow color="#00000033" offsetY="10" radius="30" />
        </effect>

        <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 30 30 20 30;">
            <Region HBox.hgrow="ALWAYS" />

            <!-- logo + title -->
            <HBox alignment="CENTER" spacing="10.0">
                <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="/logo.png" />
                    </image>
                </ImageView>

                <Label text="Your Cart" textFill="BLACK">
                    <font>
                        <Font name="Segoe UI Bold" size="36.0" />
                    </font>
                </Label>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />
        </HBox>


        <!-- subheadings -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 15 30 15 30; -fx-background-color: #f4f4f4;">
            <Label text="Order Details" textFill="BLACK" prefWidth="350.0" HBox.hgrow="ALWAYS">
                <font><Font name="Segoe UI Bold" size="18.0" /></font>
            </Label>
            
            <Label text="Price" textFill="BLACK" prefWidth="100.0" alignment="CENTER">
                <font><Font name="Segoe UI Bold" size="16.0" /></font>
            </Label>
            <Label text="Quantity" textFill="BLACK" prefWidth="120.0" alignment="CENTER">
                <font><Font name="Segoe UI Bold" size="16.0" /></font>
            </Label>
            <Label text="Total" textFill="BLACK" prefWidth="100.0" alignment="CENTER">
                <font><Font name="Segoe UI Bold" size="16.0" /></font>
            </Label>
            
            <Region prefWidth="0.0" />
        </HBox>

        <!-- Red Divider Line -->
        <Region prefHeight="2.0" style="-fx-background-color: #E75D48;" />

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="itemContainer" spacing="0.0" style="-fx-background-color: transparent;">
                    <!-- items get added here -->
                </VBox>
            </content>
        </ScrollPane>


        <VBox spacing="20.0" style="-fx-padding: 30;">
            <Region prefHeight="4.0" style="-fx-background-color: #E75D48;" />

            <!-- subtotal -->
            <HBox alignment="CENTER_RIGHT" spacing="20.0">
                <Label text="Subtotal:" textFill="BLACK">
                    <font><Font name="Segoe UI Bold" size="28.0" /></font>
                </Label>
                <Label fx:id="lblSubtotal" text="0.00" textFill="BLACK">
                    <font><Font name="Segoe UI Bold" size="28.0" /></font>
                </Label>
            </HBox>



            <HBox alignment="CENTER" spacing="20.0">
                
                <!-- back to menu button-->
                <Button fx:id="btnBack" text="Back to Menu" onAction="#onBackClicked"
                        style="-fx-background-color: #E75D48; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 20px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(231, 93, 72, 0.3), 10, 0, 0, 4);">
                    <padding><Insets top="15" right="40" bottom="15" left="40"/></padding>
                </Button>
                <Region HBox.hgrow="ALWAYS" />

                <!-- continue to checkout button -->
                <Button fx:id="btnCheckout" text="Continue to Payment" onAction="#onPaymentClicked"
                        style="-fx-background-color: #E75D48; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 20px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(231, 93, 72, 0.3), 10, 0, 0, 4);">
                    <padding><Insets top="15" right="40" bottom="15" left="40"/></padding>
                </Button>
            </HBox>
        </VBox>

    </VBox>
</StackPane>