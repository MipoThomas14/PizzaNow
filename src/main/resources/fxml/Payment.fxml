<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="700.0" prefWidth="1100.0" 
           style="-fx-background-color: linear-gradient(to bottom right, #E75D48, #B92B27);" 
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="edu.ksu.pizzanow.ui.controller.PaymentController">

    <!-- Main White Glass Card -->
    <HBox maxWidth="1000.0" maxHeight="650.0" 
          style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-background-radius: 30;">
        
        <effect>
            <DropShadow color="#00000033" offsetY="10" radius="30" />
        </effect>

        <VBox HBox.hgrow="ALWAYS" spacing="20.0" style="-fx-padding: 40;">
            
            <!-- Header -->
            <Label text="Order Summary" textFill="BLACK">
                <font><Font name="Segoe UI Bold" size="28.0" /></font>
            </Label>

            <Region prefHeight="2.0" style="-fx-background-color: #E75D48;" />

            <!-- Item List -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="summaryContainer" spacing="10.0" style="-fx-background-color: transparent;">
                        <!-- Dynamic Items added here -->
                    </VBox>
                </content>
            </ScrollPane>

            <Region prefHeight="2.0" style="-fx-background-color: #ccc;" />

            <!-- Financials -->
            <VBox spacing="10.0">
                <HBox>
                    <Label text="Subtotal" textFill="#777"><font><Font size="16.0" /></font></Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblSubtotal" text="0.00" textFill="BLACK"><font><Font name="Segoe UI Bold" size="16.0" /></font></Label>
                </HBox>
                <HBox>
                    <Label text="Tax" textFill="#777"><font><Font size="16.0" /></font></Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTax" text="0.00" textFill="BLACK"><font><Font name="Segoe UI Bold" size="16.0" /></font></Label>
                </HBox>
                <Region prefHeight="1.0" style="-fx-background-color: #eee;" />
                <HBox>
                    <Label text="Grand Total" textFill="BLACK"><font><Font name="Segoe UI Bold" size="22.0" /></font></Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTotal" text="0.00" textFill="#E75D48"><font><Font name="Segoe UI Bold" size="22.0" /></font></Label>
                </HBox>
            </VBox>

            <!-- Back to Cart Button -->
            <Button text="Back to Cart" onAction="#onBackToCartClicked" maxWidth="Infinity"
                    style="-fx-background-color: white; -fx-text-fill: #E75D48; -fx-border-color: #E75D48; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;">
                <padding><Insets top="10" bottom="10"/></padding>
            </Button>
        </VBox>

        <!-- Vertical Divider -->
        <Region prefWidth="2.0" style="-fx-background-color: #eee;" />

        <!-- ================= RIGHT SECTION: CHECKOUT OPTIONS ================= -->
        <VBox HBox.hgrow="ALWAYS" spacing="25.0" style="-fx-padding: 40;">
            
            <Label text="Checkout Details" textFill="BLACK">
                <font><Font name="Segoe UI Bold" size="28.0" /></font>
            </Label>

            <!-- 1. Delivery Type -->
            <VBox spacing="10.0">
                <Label text="1. Order Type" textFill="#555"><font><Font name="Segoe UI Bold" size="16.0" /></font></Label>
                <HBox spacing="15.0">
                    <Button fx:id="btnPickup" text="Pickup" onAction="#onPickupClicked" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #f9f9f9; -fx-text-fill: #333; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 16px; -fx-cursor: hand;">
                        <padding><Insets top="15" bottom="15"/></padding>
                    </Button>
                    <Button fx:id="btnDelivery" text="Delivery" onAction="#onDeliveryClicked" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #f9f9f9; -fx-text-fill: #333; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 16px; -fx-cursor: hand;">
                        <padding><Insets top="15" bottom="15"/></padding>
                    </Button>
                </HBox>
            </VBox>

            <!-- 2. Payment Type -->
            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                <Label text="2. Payment Method" textFill="#555"><font><Font name="Segoe UI Bold" size="16.0" /></font></Label>
                <HBox spacing="15.0">
                    <Button fx:id="btnCash" text="Cash" onAction="#onCashClicked" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #f9f9f9; -fx-text-fill: #333; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 15px; -fx-cursor: hand;">
                        <padding><Insets top="15" bottom="15"/></padding>
                    </Button>
                    <Button fx:id="btnDebit" text="Debit" onAction="#onDebitClicked" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #f9f9f9; -fx-text-fill: #333; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 15px; -fx-cursor: hand;">
                        <padding><Insets top="15" bottom="15"/></padding>
                    </Button>
                    <Button fx:id="btnCredit" text="Credit" onAction="#onCreditClicked" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #f9f9f9; -fx-text-fill: #333; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 15px; -fx-cursor: hand;">
                        <padding><Insets top="15" bottom="15"/></padding>
                    </Button>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Confirm Button -->
            <Button fx:id="btnConfirm" text="Confirm Payment" onAction="#onConfirmClicked" maxWidth="Infinity"
                    style="-fx-background-color: #E75D48; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 22px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(231, 93, 72, 0.3), 10, 0, 0, 4);">
                <padding><Insets top="15" bottom="15"/></padding>
            </Button>

        </VBox>

    </HBox>
</StackPane>